# Africa Connect — production environment template
#
# This documents every variable a real production deployment needs. It is a
# template, not a real env file — leave it committed with blank values and
# set the actual secrets in your hosting provider's dashboard (Vercel →
# Project → Settings → Environment Variables, scoped to "Production").
# Never commit real values here or in any `.env.production.local` file.
#
# Vite only inlines `VITE_`-prefixed variables into the client bundle — the
# rest are read server-side only, inside api/*.ts, and are never shipped to
# the browser.

# --- Supabase (client + server) ---
# Project URL and public anon key — Project Settings → API. Both must be set
# together; src/lib/supabase.ts checks for both before using Supabase and
# falls back to local mock storage if either is missing (that fallback is
# meant for offline/local development — a production deploy should always
# set these two so real buyers/farmers share one live database).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key — Project Settings → API → service_role secret. Used only
# by the serverless webhook handlers (api/stripe-webhook.ts,
# api/flutterwave-webhook.ts) to update order rows on payment events,
# bypassing RLS the way an authenticated buyer/farmer session can't (a
# webhook has no user session at all). Deliberately NOT prefixed with
# VITE_ — never expose this key to client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (server-side webhook verification) ---
# Secret key — Developers → API keys. Required only once you add a
# create-PaymentIntent endpoint; the webhook handler itself doesn't call the
# Stripe API, but the SDK needs a key to construct.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint — Developers → Webhooks → your
# endpoint → Signing secret. Required for api/stripe-webhook.ts to validate
# that events actually came from Stripe.
STRIPE_WEBHOOK_SECRET=

# --- Flutterwave (server-side webhook verification) ---
# The "secret hash" you set under Settings → Webhooks in the Flutterwave
# dashboard. Flutterwave echoes it back in the `verif-hash` request header on
# every webhook call; api/flutterwave-webhook.ts rejects any request where it
# doesn't match exactly.
FLUTTERWAVE_SECRET_HASH=

# --- Client-side payment public keys (see .env.example for details) ---
VITE_FLUTTERWAVE_PUBLIC_KEY=
VITE_STRIPE_PUBLIC_KEY=
