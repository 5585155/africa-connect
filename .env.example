# Africa Connect — environment variables
#
# The app currently runs entirely client-side: listings, auth, messaging, and
# orders are mock data persisted to the browser's localStorage (see
# src/context/*.tsx). No environment variables are required to build, run, or
# deploy it as-is.
#
# The variables below are placeholders for the integrations this app would
# need once it talks to a real backend. Copy this file to `.env.local` and
# fill in real values only when wiring up those services — Vite only exposes
# variables prefixed with VITE_ to client code.

# Base URL of the backend API (listings, auth, messaging, orders).
# VITE_API_BASE_URL=https://api.example.com

# Live FX rate provider, used in place of the mocked rates in src/lib/currency.ts.
# VITE_EXCHANGE_RATE_API_KEY=

# Real escrow / payment processor key, used in place of the simulated payment
# in src/components/EscrowPaymentModal.tsx.
# VITE_ESCROW_PROVIDER_KEY=
