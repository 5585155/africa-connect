# Africa Connect — environment variables
#
# The app runs entirely on local mock storage (see src/hooks/useLocalStorage.ts)
# when the Supabase variables below are unset — listings, auth, messaging, and
# orders all persist to the browser's localStorage instead. No environment
# variables are required to build, run, or deploy it in that mode.
#
# Copy this file to `.env.local` and fill in real values only when you want to
# connect a live Supabase project (run supabase/schema.sql against it first).
# Vite only exposes variables prefixed with VITE_ to client code.

# Project URL and public anon key from Supabase → Project Settings → API.
# Both must be set together — the app checks for both before using Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Not yet wired up — placeholders for future integrations ---

# Live FX rate provider, used in place of the mocked rates in src/lib/currency.ts.
# VITE_EXCHANGE_RATE_API_KEY=

# Real escrow / payment processor key, used in place of the simulated payment
# in src/components/EscrowPaymentModal.tsx.
# VITE_ESCROW_PROVIDER_KEY=
