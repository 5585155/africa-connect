# Africa Connect — environment variables
#
# The app runs entirely on local mock storage and sandboxed payments (see
# src/hooks/useLocalStorage.ts) when the variables below are unset — listings,
# auth, messaging, and orders persist to the browser's localStorage, and
# escrow funding simulates a successful Flutterwave/Stripe charge. No
# environment variables are required to build, run, or deploy it in that mode.
#
# Copy this file to `.env.local` and fill in real values only when you want to
# connect a live backend. Vite only exposes variables prefixed with VITE_ to
# client code.

# --- Supabase (optional) ---
# Project URL and public anon key from Supabase → Project Settings → API.
# Both must be set together — the app checks for both before using Supabase.
# Run supabase/schema.sql against your project first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Payment gateways (optional) ---
# Flutterwave public key (Project → Settings → API) — enables their real
# inline checkout (Mobile Money, local bank transfer, African cards) from
# src/lib/flutterwave.ts. Use a FLWPUBK_TEST-... key for sandbox testing.
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Stripe publishable key (Developers → API keys) — loads the real Stripe.js
# SDK from src/lib/stripe.ts. Note: confirming an actual charge needs a
# backend to create a PaymentIntent/Checkout Session, which this app doesn't
# have, so the charge itself is still simulated once the SDK is confirmed to load.
VITE_STRIPE_PUBLIC_KEY=

# Paystack public (test or live) key — Settings → API Keys & Webhooks. Powers
# the real inline checkout in src/components/PaystackButton.tsx. A pk_test_...
# key already gives you Paystack's own sandbox with real test card numbers,
# so there's no separate client-side simulation for this one.
VITE_PAYSTACK_PUBLIC_KEY=

# Live exchange rates (USD, EUR, KES, NGN, GHS, ETB) are fetched from the free,
# keyless https://open.er-api.com/v6/latest/USD and cached in localStorage for
# a day — see src/lib/currency.ts. No API key needed; it falls back to the
# static rates baked into that file if the request fails or you're offline.
